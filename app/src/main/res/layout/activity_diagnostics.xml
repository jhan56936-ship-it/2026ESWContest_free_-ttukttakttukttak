<?xml version="1.0" encoding="utf-8"?>
<!--
    테스트(자가진단) 화면.
    기기가 없어도 앱이 제대로 동작하는지 한 화면에서 모두 확인할 수 있습니다.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vk_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_m">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                style="@style/VkButton.Outline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/back"
                app:icon="@drawable/ic_back"
                app:iconGravity="textStart" />

            <TextView
                style="@style/VkText.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:layout_weight="1"
                android:text="@string/test_title"
                android:textSize="@dimen/text_huge" />
        </LinearLayout>

        <!-- 전체 검사 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRunAll"
            style="@style/VkButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:minHeight="@dimen/touch_big"
            android:text="@string/test_run_all"
            android:textSize="@dimen/text_title"
            app:icon="@drawable/ic_check"
            app:iconGravity="textStart" />

        <TextView
            android:id="@+id/testSummary"
            style="@style/VkText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:background="@drawable/bg_card"
            android:padding="@dimen/space_m"
            android:text="@string/test_not_run"
            android:textStyle="bold" />

        <!-- 검사 결과 목록 -->
        <LinearLayout
            android:id="@+id/resultContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:orientation="vertical" />

        <!-- 가상 버튼 -->
        <TextView
            style="@style/VkText.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:layout_marginBottom="@dimen/space_s"
            android:text="@string/test_signal_section" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/space_m">

            <TextView
                style="@style/VkText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/test_signal_hint" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSignal1"
                    style="@style/VkButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:text="1번" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSignal2"
                    style="@style/VkButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/space_xs"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:text="2번"
                    app:backgroundTint="@color/vk_slot_2" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSignal3"
                    style="@style/VkButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xs"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:text="3번"
                    app:backgroundTint="@color/vk_slot_3" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSignalAi"
                style="@style/VkButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/test_signal_ai"
                app:backgroundTint="@color/vk_accent"
                app:icon="@drawable/ic_sparkle"
                app:iconGravity="textStart" />

            <!--
                일부러 깨뜨린 신호를 넣어 보는 단추입니다.
                아무 앱도 열리지 않고 기록에만 "실행 안 함"이 남아야 정상입니다.
            -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSignalNoise"
                style="@style/VkButton.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/test_signal_noise"
                app:icon="@drawable/ic_alert"
                app:iconGravity="textStart" />
        </LinearLayout>

        <!-- 받은 신호 기록 -->
        <TextView
            style="@style/VkText.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:layout_marginBottom="@dimen/space_s"
            android:text="@string/test_log_section" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_soft"
            android:orientation="vertical"
            android:padding="@dimen/space_m">

            <TextView
                android:id="@+id/logText"
                style="@style/VkText.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="@string/test_log_empty"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearLog"
                style="@style/VkButton.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/test_log_clear" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_xl" />
    </LinearLayout>
</ScrollView>
