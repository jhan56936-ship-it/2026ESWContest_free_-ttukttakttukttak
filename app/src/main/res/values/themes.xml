<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.VibeKey" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/vk_primary</item>
        <item name="colorPrimaryDark">@color/vk_primary_dark</item>
        <item name="colorAccent">@color/vk_primary</item>
        <item name="colorOnPrimary">@color/vk_white</item>
        <item name="android:colorBackground">@color/vk_background</item>
        <item name="android:textColorPrimary">@color/vk_text</item>
        <item name="android:textColorSecondary">@color/vk_text_secondary</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/vk_background</item>
        <item name="android:navigationBarColor" tools:targetApi="21">@color/vk_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
    </style>

    <!-- 화면 없이 동작만 하고 사라지는 액티비티(삼성 루틴 실행용) -->
    <style name="Theme.VibeKey.Invisible" parent="Theme.VibeKey">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <!-- 큰 글씨 기본 버튼: 손 떨림을 고려해 높이와 글자를 크게 -->
    <style name="VkButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">@dimen/space_l</item>
        <item name="android:paddingEnd">@dimen/space_l</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">18dp</item>
        <item name="backgroundTint">@color/vk_primary</item>
        <item name="android:textColor">@color/vk_white</item>
        <item name="iconTint">@color/vk_white</item>
        <item name="iconSize">28dp</item>
        <item name="iconPadding">@dimen/space_s</item>
    </style>

    <style name="VkButton.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/vk_primary</item>
        <item name="cornerRadius">18dp</item>
        <item name="strokeColor">@color/vk_primary</item>
        <item name="strokeWidth">2dp</item>
        <item name="iconTint">@color/vk_primary</item>
        <item name="iconSize">28dp</item>
        <item name="iconPadding">@dimen/space_s</item>
    </style>

    <style name="VkText.Title" parent="">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/vk_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="VkText.Body" parent="">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/vk_text</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <style name="VkText.Label" parent="">
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textColor">@color/vk_text_secondary</item>
    </style>
</resources>
